<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-press shortcuts on the launcher icon, the first four of the web app's
  (www/manifest.webmanifest): launchers show about four (#488). Each opens the
  app with chogan://game/<id>, and MainActivity loads that game's own page.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="tower-defence" android:enabled="true"
        android:icon="@drawable/shortcut_tower_defence"
        android:shortcutShortLabel="@string/shortcut_tower_defence">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.choganhq.chogan"
            android:targetClass="io.github.choganhq.chogan.MainActivity"
            android:data="chogan://game/tower-defence" />
    </shortcut>
    <shortcut android:shortcutId="sudoku" android:enabled="true"
        android:icon="@drawable/shortcut_sudoku"
        android:shortcutShortLabel="@string/shortcut_sudoku">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.choganhq.chogan"
            android:targetClass="io.github.choganhq.chogan.MainActivity"
            android:data="chogan://game/sudoku" />
    </shortcut>
    <shortcut android:shortcutId="minesweeper" android:enabled="true"
        android:icon="@drawable/shortcut_minesweeper"
        android:shortcutShortLabel="@string/shortcut_minesweeper">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.choganhq.chogan"
            android:targetClass="io.github.choganhq.chogan.MainActivity"
            android:data="chogan://game/minesweeper" />
    </shortcut>
    <shortcut android:shortcutId="dots" android:enabled="true"
        android:icon="@drawable/shortcut_dots"
        android:shortcutShortLabel="@string/shortcut_dots">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.choganhq.chogan"
            android:targetClass="io.github.choganhq.chogan.MainActivity"
            android:data="chogan://game/dots" />
    </shortcut>
</shortcuts>
